/* ===== CASECRAFT AI - FRESH ANIME DESIGN ===== */
/* Inspired by vibrant anime interfaces with bold, playful aesthetics */

/* ===== ROOT COLORS ===== */
:root {
  --primary: #ff006e;    /* Bold magenta */
  --secondary: #00f5ff;  /* Cyan */
  --accent: #ffbe0b;     /* Golden yellow */
  --success: #3a86ff;    /* Vivid blue */
  --dark: #0a0e27;       /* Deep navy */
  --darker: #050810;     /* Almost black */
  --card-bg: #1a1f3a;    /* Darker blue-purple */
  --text-main: #e0e0ff;  /* Light purple-white */
  --text-sub: #a0a0d0;   /* Muted purple */
  --border: #2a3f6f;     /* Blue border */
}

/* ===== RESET & BASE ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body, #root {
  width: 100%;
  height: 100%;
}

body {
  font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background: linear-gradient(145deg, var(--darker) 0%, var(--dark) 50%, #0f1935 100%);
  color: var(--text-main);
  overflow-x: hidden;
  letter-spacing: 0.3px;
}

/* ===== APP WRAPPER ===== */
.app-wrapper {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ===== HEADER - FUTURISTIC STYLE ===== */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  padding: 14px 28px;
  background: linear-gradient(90deg, rgba(10, 14, 39, 0.9) 0%, rgba(26, 31, 58, 0.85) 100%);
  border-bottom: 2px solid var(--secondary);
  display: flex;
  justify-content: space-between;
  align-items: center;
  backdrop-filter: blur(10px);
  box-shadow: 0 4px 20px rgba(0, 245, 255, 0.1);
}

.navbar-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.navbar-logo:hover {
  transform: scale(1.08) rotate(2deg);
}

.logo-icon {
  font-size: 1.8rem;
  animation: neon-glow 2s ease-in-out infinite;
}

@keyframes neon-glow {
  0%, 100% {
    text-shadow: 0 0 8px var(--primary), 0 0 16px var(--primary);
  }
  50% {
    text-shadow: 0 0 12px var(--secondary), 0 0 24px var(--secondary);
  }
}

.navbar-wordmark {
  font-family: 'Orbitron', sans-serif;
  font-size: 1.25rem;
  font-weight: 900;
  letter-spacing: 2px;
  background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-transform: uppercase;
}

.navbar-badge {
  font-size: 0.55rem;
  font-weight: 900;
  letter-spacing: 1px;
  padding: 3px 8px;
  border-radius: 4px;
  background: linear-gradient(135deg, var(--accent), var(--primary));
  color: #000;
  text-transform: uppercase;
  box-shadow: 0 0 10px var(--accent);
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.nav-link {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 7px 12px;
  border-radius: 6px;
  color: var(--text-sub);
  text-decoration: none;
  font-size: 0.8rem;
  font-weight: 700;
  transition: all 0.2s;
  border: 1px solid transparent;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.nav-link:hover {
  background: rgba(0, 245, 255, 0.1);
  color: var(--secondary);
  border-color: var(--secondary);
  transform: translateY(-2px);
  box-shadow: 0 0 10px rgba(0, 245, 255, 0.3);
}

.kofi-link {
  background: rgba(255, 0, 110, 0.1);
  border-color: rgba(255, 0, 110, 0.3);
  color: #ff69b4;
}

.kofi-link:hover {
  background: rgba(255, 0, 110, 0.2);
  border-color: var(--primary);
  color: var(--primary);
  box-shadow: 0 0 12px rgba(255, 0, 110, 0.4);
}

.nav-session-tag {
  font-size: 0.65rem;
  color: var(--text-sub);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* ===== SESSION NOTICE ===== */
.session-notice {
  background: linear-gradient(90deg, rgba(255, 190, 11, 0.1) 0%, rgba(255, 190, 11, 0.05) 100%);
  border-top: 2px solid var(--accent);
  border-bottom: 2px solid var(--accent);
  color: var(--accent);
  padding: 14px 20px;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  font-size: 0.82rem;
  line-height: 1.4;
}

.notice-icon {
  font-size: 1rem;
  animation: wiggle 0.6s ease-in-out infinite;
}

@keyframes wiggle {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-3deg); }
  75% { transform: rotate(3deg); }
}

.notice-close {
  background: none;
  border: none;
  color: var(--accent);
  cursor: pointer;
  font-size: 1.1rem;
  transition: all 0.2s;
  padding: 4px;
}

.notice-close:hover {
  transform: scale(1.15);
  color: var(--primary);
}

/* ===== HERO SECTION ===== */
.hero {
  text-align: center;
  padding: 40px 24px 28px;
  background: radial-gradient(circle at 50% 0%, rgba(0, 245, 255, 0.05) 0%, transparent 70%);
}

.hero-sakura {
  font-size: 1.1rem;
  margin-bottom: 10px;
  animation: twirl 4s linear infinite;
}

@keyframes twirl {
  from { transform: rotate(0deg) translateX(0); }
  to { transform: rotate(360deg) translateX(0); }
}

.hero-title {
  margin: 0 0 12px;
}

.hero-title-line1 {
  display: block;
  font-size: clamp(1.7rem, 5vw, 2.8rem);
  font-weight: 900;
  color: var(--primary);
  text-shadow: 2px 2px 0 rgba(0, 245, 255, 0.3), 4px 4px 0 rgba(0, 0, 0, 0.5);
  letter-spacing: 1px;
}

.hero-title-line2 {
  display: block;
  font-size: clamp(1.4rem, 4vw, 2.4rem);
  font-weight: 800;
  color: var(--secondary);
  text-shadow: 2px 2px 0 var(--primary), -2px -2px 0 rgba(0, 0, 0, 0.3);
}

.hero-sub {
  font-size: 0.95rem;
  color: var(--text-sub);
  max-width: 700px;
  margin: 16px auto 0;
  line-height: 1.6;
}

.hero-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin-top: 18px;
}

.hero-chip {
  display: inline-block;
  padding: 7px 14px;
  background: linear-gradient(135deg, rgba(58, 134, 255, 0.15), rgba(0, 245, 255, 0.1));
  border: 1.5px solid var(--secondary);
  border-radius: 16px;
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  transition: all 0.3s;
  cursor: default;
}

.hero-chip:hover {
  background: linear-gradient(135deg, rgba(0, 245, 255, 0.2), rgba(58, 134, 255, 0.15));
  box-shadow: 0 0 12px var(--secondary);
  transform: translateY(-2px);
}

/* ===== DISCLAIMER BOX ===== */
.disclaimer-box {
  max-width: 1100px;
  margin: 0 auto;
  padding: 0 20px;
  margin-bottom: 10px;
}

.disclaimer-inner {
  padding: 16px 20px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(58, 134, 255, 0.08) 0%, rgba(0, 245, 255, 0.04) 100%);
  border: 2px solid var(--secondary);
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 12px;
  box-shadow: 0 0 20px rgba(0, 245, 255, 0.1);
}

.disclaimer-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 0.75rem;
  color: var(--text-sub);
  line-height: 1.4;
}

.disclaimer-item .d-icon {
  font-size: 0.95rem;
  flex-shrink: 0;
  margin-top: 1px;
}

.disclaimer-item a {
  color: var(--accent);
  text-decoration: none;
  font-weight: 700;
  transition: all 0.2s;
}

.disclaimer-item a:hover {
  text-decoration: underline;
  text-shadow: 0 0 8px var(--accent);
}

.disclaimer-divider {
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--secondary), transparent);
  grid-column: 1 / -1;
  margin: 2px 0;
}

/* ===== MAIN GRID ===== */
.main-grid {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
  padding: 0 20px 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

@media (max-width: 1024px) {
  .main-grid {
    grid-template-columns: 1fr;
  }
}

/* ===== PANELS ===== */
.panel {
  padding: 24px;
  border-radius: 12px;
  background: var(--card-bg);
  border: 2px solid var(--border);
  transition: all 0.3s;
  animation: pop-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}

.panel:nth-child(1) { animation-delay: 0.1s; }
.panel:nth-child(2) { animation-delay: 0.2s; }

@keyframes pop-in {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(20px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.panel:hover {
  border-color: var(--secondary);
  box-shadow: 0 0 20px rgba(0, 245, 255, 0.2);
  transform: translateY(-4px);
}

.glass {
  background: var(--card-bg);
  border: 2px solid var(--border);
  border-radius: 12px;
  backdrop-filter: blur(10px);
}

.panel-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  padding-bottom: 12px;
  border-bottom: 2px dashed var(--secondary);
}

.panel-icon {
  font-size: 1.3rem;
  animation: bounce-icon 1.5s ease-in-out infinite;
}

@keyframes bounce-icon {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5px); }
}

.panel-title {
  font-size: 1.05rem;
  font-weight: 800;
  color: var(--text-main);
  text-transform: uppercase;
  letter-spacing: 1px;
}

/* ===== FORM FIELDS ===== */
.field-group {
  margin-bottom: 16px;
}

.field-label {
  display: block;
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--secondary);
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.field-input,
.field-select {
  width: 100%;
  padding: 10px 14px;
  border-radius: 8px;
  border: 2px solid var(--border);
  background: rgba(10, 14, 39, 0.6);
  color: var(--text-main);
  font-family: 'Nunito', sans-serif;
  font-size: 0.9rem;
  transition: all 0.3s;
}

.field-input:focus,
.field-select:focus {
  outline: none;
  border-color: var(--secondary);
  background: rgba(10, 14, 39, 0.9);
  box-shadow: 0 0 15px rgba(0, 245, 255, 0.3);
}

.field-input::placeholder {
  color: var(--text-sub);
}

/* ===== RANGE SLIDER ===== */
.range-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.range-row input[type="range"] {
  flex: 1;
  height: 5px;
  border-radius: 3px;
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  outline: none;
  -webkit-appearance: none;
  appearance: none;
}

.range-row input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  cursor: pointer;
  box-shadow: 0 0 12px var(--secondary);
  border: 2px solid var(--secondary);
  transition: all 0.2s;
}

.range-row input[type="range"]::-moz-range-thumb {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  cursor: pointer;
  box-shadow: 0 0 12px var(--secondary);
  border: 2px solid var(--secondary);
}

.range-val {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--secondary);
  min-width: 40px;
  text-align: center;
}

/* ===== PROVIDER TABS ===== */
.provider-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 14px;
}

.provider-tab {
  padding: 10px 12px;
  border-radius: 8px;
  border: 2px solid var(--border);
  background: rgba(26, 31, 58, 0.6);
  color: var(--text-sub);
  font-size: 0.75rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.provider-tab:hover {
  background: rgba(26, 31, 58, 0.9);
  border-color: var(--secondary);
  color: var(--secondary);
  transform: translateY(-2px);
}

.provider-tab.active {
  background: linear-gradient(135deg, rgba(0, 245, 255, 0.2), rgba(58, 134, 255, 0.15));
  border-color: var(--secondary);
  color: var(--text-main);
  box-shadow: 0 0 15px rgba(0, 245, 255, 0.4);
}

.tab-badge {
  font-size: 0.6rem;
  padding: 1px 5px;
  border-radius: 3px;
  background: rgba(255, 190, 11, 0.2);
  font-weight: 800;
  color: var(--accent);
}

/* ===== PROVIDER PANELS ===== */
.provider-panel {
  background: rgba(58, 134, 255, 0.08);
  border: 1px solid var(--secondary);
  border-radius: 8px;
  padding: 12px;
  margin-top: 10px;
}

.provider-panel-banner {
  padding: 10px 12px;
  border-radius: 8px;
  font-size: 0.75rem;
  line-height: 1.4;
  margin-bottom: 10px;
  background: linear-gradient(135deg, rgba(58, 134, 255, 0.15), rgba(0, 245, 255, 0.1));
  border: 1px solid var(--secondary);
  color: var(--secondary);
}

.openrouter-banner {
  background: linear-gradient(135deg, rgba(0, 245, 255, 0.15), rgba(58, 134, 255, 0.1));
  border-color: var(--secondary);
  color: #64e7ff;
}

.ollama-banner {
  background: linear-gradient(135deg, rgba(58, 134, 255, 0.15), rgba(0, 245, 255, 0.1));
  border-color: var(--success);
  color: #3a86ff;
}

.provider-panel-banner a {
  color: inherit;
  font-weight: 700;
  text-decoration: underline;
  transition: all 0.2s;
}

.provider-panel-banner a:hover {
  filter: brightness(1.2);
}

.api-key-box {
  display: flex;
  gap: 6px;
  margin-bottom: 10px;
}

.api-key-box input {
  flex: 1;
}

.provider-tip {
  font-size: 0.7rem;
  color: var(--text-sub);
  line-height: 1.4;
}

.provider-tip a {
  color: var(--secondary);
  text-decoration: none;
  font-weight: 700;
}

/* ===== OLLAMA STATUS ===== */
.ollama-status {
  font-size: 0.65rem;
  font-weight: 800;
  margin-left: 6px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  animation: pulse 1s ease-in-out infinite;
}

.ollama-status.checking {
  color: var(--accent);
}

.ollama-status.ok {
  color: var(--success);
}

.ollama-status.err {
  color: var(--primary);
}

@keyframes pulse {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

.input-error {
  border-color: var(--primary) !important;
  background: rgba(255, 0, 110, 0.1) !important;
}

.input-ok {
  border-color: var(--success) !important;
}

.ollama-models-found {
  font-size: 0.7rem;
  color: var(--success);
  margin-top: 6px;
  padding: 6px;
  background: rgba(58, 134, 255, 0.15);
  border-radius: 6px;
  border-left: 2px solid var(--success);
}

.ollama-error-box {
  font-size: 0.7rem;
  color: #ff9999;
  margin-top: 6px;
  padding: 8px;
  background: rgba(255, 0, 110, 0.1);
  border: 1px solid var(--primary);
  border-radius: 6px;
  line-height: 1.5;
}

.inline-code {
  font-family: 'Courier New', monospace;
  font-size: 0.7rem;
  background: rgba(0, 245, 255, 0.15);
  padding: 2px 5px;
  border-radius: 3px;
  color: var(--secondary);
  font-weight: 700;
  border: 1px solid var(--secondary);
}

.block-code {
  display: block;
  margin: 4px 0;
}

/* ===== STYLE SELECTOR ===== */
.style-selector {
  margin: 16px 0;
  padding: 14px 0;
  border-top: 2px dashed var(--secondary);
  border-bottom: 2px dashed var(--secondary);
}

.style-selector-label {
  font-size: 0.85rem;
  font-weight: 800;
  color: var(--secondary);
  margin-bottom: 10px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.style-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  gap: 8px;
}

.style-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 10px;
  border-radius: 8px;
  background: rgba(26, 31, 58, 0.6);
  border: 2px solid var(--border);
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  text-align: center;
}

.style-card:hover {
  background: rgba(26, 31, 58, 0.9);
  border-color: var(--secondary);
  transform: translateY(-3px);
}

.style-card.active {
  background: linear-gradient(135deg, rgba(0, 245, 255, 0.2), rgba(58, 134, 255, 0.15));
  border-color: var(--secondary);
  box-shadow: 0 0 12px rgba(0, 245, 255, 0.3);
}

.style-emoji {
  font-size: 1.3rem;
}

.style-name {
  font-weight: 700;
  font-size: 0.8rem;
  color: var(--text-main);
}

.style-desc {
  font-size: 0.6rem;
  color: var(--text-sub);
  line-height: 1.2;
}

/* ===== ERROR MESSAGE ===== */
.error-msg {
  padding: 10px 12px;
  border-radius: 8px;
  background: rgba(255, 0, 110, 0.12);
  border: 2px solid var(--primary);
  color: #ff9999;
  font-size: 0.8rem;
  line-height: 1.3;
  margin-top: 10px;
}

/* ===== SUBTOPICS ===== */
.subtopics-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.subtopic-item {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 8px;
  background: rgba(10, 14, 39, 0.6);
  border: 1.5px solid var(--border);
  transition: all 0.3s;
  cursor: grab;
}

.subtopic-item:hover {
  background: rgba(10, 14, 39, 0.9);
  border-color: var(--secondary);
  box-shadow: 0 0 10px rgba(0, 245, 255, 0.15);
}

.subtopic-item.disabled {
  opacity: 0.5;
}

.drag-handle {
  font-size: 0.95rem;
  color: var(--text-sub);
  cursor: grab;
  flex-shrink: 0;
  transition: color 0.2s;
}

.subtopic-item:hover .drag-handle {
  color: var(--secondary);
}

.subtopic-check {
  width: 16px;
  height: 16px;
  cursor: pointer;
  accent-color: var(--secondary);
}

.subtopic-name {
  flex: 1;
  font-size: 0.85rem;
  color: var(--text-main);
}

.subtopic-name.custom-name {
  border: 1px solid var(--border);
  border-radius: 5px;
  padding: 3px 7px;
  background: rgba(10, 14, 39, 0.4);
}

.subtopic-badge {
  font-size: 0.6rem;
  padding: 3px 8px;
  border-radius: 5px;
  background: rgba(255, 190, 11, 0.15);
  border: 1px solid var(--accent);
  color: var(--accent);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.subtopic-badge.custom-badge {
  background: rgba(0, 245, 255, 0.15);
  border-color: var(--secondary);
  color: var(--secondary);
}

.subtopic-actions {
  display: flex;
  gap: 5px;
  flex-shrink: 0;
}

.icon-btn {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 0.9rem;
  padding: 3px 5px;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn:hover {
  transform: scale(1.2) rotate(10deg);
}

.icon-btn.prompt-btn {
  filter: drop-shadow(0 0 2px var(--secondary));
}

.icon-btn.del {
  color: var(--primary);
}

.add-topic-row {
  display: flex;
  gap: 6px;
  margin-top: 10px;
}

.add-topic-row input {
  flex: 1;
}

/* ===== GENERATE AREA ===== */
.generate-area {
  max-width: 1200px;
  margin: 28px auto;
  width: 100%;
  padding: 0 20px;
  text-align: center;
}

.btn-generate {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 44px;
  font-size: 1rem;
  font-weight: 800;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #000;
  border: 2px solid var(--primary);
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 6px 20px rgba(255, 0, 110, 0.3);
  text-transform: uppercase;
  letter-spacing: 1px;
  font-family: 'Orbitron', sans-serif;
}

.btn-generate:hover:not(:disabled) {
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(255, 0, 110, 0.5), 0 0 20px rgba(0, 245, 255, 0.3);
}

.btn-generate:active:not(:disabled) {
  transform: translateY(-1px);
}

.btn-generate:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.generate-hint {
  margin-top: 10px;
  font-size: 0.8rem;
  color: var(--text-sub);
  font-style: italic;
}

/* ===== FOOTER ===== */
.footer {
  text-align: center;
  padding: 28px 20px;
  border-top: 2px solid var(--border);
  color: var(--text-sub);
  font-size: 0.8rem;
  line-height: 1.8;
}

.sakura-strip {
  font-size: 1.1rem;
  margin-bottom: 10px;
  letter-spacing: 3px;
  animation: spin-text 4s linear infinite;
}

@keyframes spin-text {
  0% { transform: rotateY(0deg); }
  100% { transform: rotateY(360deg); }
}

.footer a {
  color: var(--secondary);
  text-decoration: none;
  font-weight: 700;
  transition: all 0.2s;
}

.footer a:hover {
  color: var(--primary);
  text-shadow: 0 0 8px var(--primary);
}

/* ===== MODAL ===== */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(5, 8, 16, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  backdrop-filter: blur(5px);
  animation: fade-in 0.2s ease;
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-content {
  background: linear-gradient(135deg, var(--dark), var(--card-bg));
  border: 2px solid var(--secondary);
  border-radius: 12px;
  padding: 28px;
  max-width: 550px;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0, 245, 255, 0.2);
  animation: slide-up 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes slide-up {
  from {
    opacity: 0;
    transform: translateY(30px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 2px dashed var(--secondary);
}

.modal-header h3 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--text-main);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.modal-close {
  background: none;
  border: none;
  color: var(--text-sub);
  font-size: 1.5rem;
  cursor: pointer;
  padding: 0;
  transition: all 0.2s;
}

.modal-close:hover {
  color: var(--primary);
  transform: rotate(90deg) scale(1.2);
}

.modal-hint {
  font-size: 0.8rem;
  color: var(--text-sub);
  margin-bottom: 14px;
  line-height: 1.5;
}

.prompt-textarea {
  width: 100%;
  padding: 12px;
  border: 2px solid var(--border);
  border-radius: 8px;
  background: rgba(10, 14, 39, 0.8);
  color: var(--text-main);
  font-family: 'Nunito', sans-serif;
  font-size: 0.85rem;
  line-height: 1.5;
  resize: vertical;
  margin-bottom: 16px;
  transition: all 0.3s;
}

.prompt-textarea:focus {
  outline: none;
  border-color: var(--secondary);
  background: rgba(10, 14, 39, 0.95);
  box-shadow: 0 0 12px rgba(0, 245, 255, 0.3);
}

.modal-actions {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
}

/* ===== BUTTONS ===== */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 9px 18px;
  border-radius: 8px;
  border: 2px solid transparent;
  font-family: 'Nunito', sans-serif;
  font-weight: 700;
  font-size: 0.8rem;
  cursor: pointer;
  transition: all 0.3s;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: #000;
  box-shadow: 0 4px 12px rgba(255, 0, 110, 0.3);
}

.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(0, 245, 255, 0.4);
}

.btn-ghost {
  background: rgba(26, 31, 58, 0.6);
  border-color: var(--border);
  color: var(--text-sub);
}

.btn-ghost:hover {
  background: rgba(26, 31, 58, 0.9);
  border-color: var(--secondary);
  color: var(--secondary);
}

.btn-secondary {
  background: transparent;
  border-color: var(--secondary);
  color: var(--secondary);
}

.btn-secondary:hover {
  background: rgba(0, 245, 255, 0.1);
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
  .navbar {
    padding: 10px 16px;
  }

  .navbar-wordmark {
    font-size: 1rem;
    letter-spacing: 1px;
  }

  .hero {
    padding: 28px 16px 20px;
  }

  .hero-title-line1 {
    font-size: 1.4rem;
  }

  .hero-title-line2 {
    font-size: 1.2rem;
  }

  .main-grid {
    padding: 0 16px 32px;
    gap: 14px;
  }

  .panel {
    padding: 18px;
  }

  .provider-tabs {
    grid-template-columns: 1fr;
  }

  .style-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .btn-generate {
    padding: 11px 32px;
    font-size: 0.9rem;
  }
}


/* ===== RESULT PAGE ===== */
.result-page {
  max-width: 950px;
  margin: 0 auto;
  padding: 0 20px 40px;
  animation: fade-in 0.4s ease;
}

.result-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: space-between;
  padding: 18px 0;
  border-bottom: 2px dashed var(--secondary);
  margin-bottom: 18px;
}

.result-toolbar-left,
.result-toolbar-right {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.result-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 20px;
}

.meta-chip {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 8px 14px;
  border-radius: 8px;
  background: linear-gradient(135deg, rgba(0, 245, 255, 0.12), rgba(58, 134, 255, 0.08));
  border: 1.5px solid var(--secondary);
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--text-main);
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

.result-doc {
  background: linear-gradient(135deg, rgba(26, 31, 58, 0.8), rgba(26, 31, 58, 0.6));
  border: 2px solid var(--border);
  border-radius: 12px;
  padding: 36px 40px;
  line-height: 1.8;
  box-shadow: 0 0 20px rgba(0, 245, 255, 0.1);
  margin-top: 14px;
}

@media (max-width: 600px) {
  .result-doc {
    padding: 20px 16px;
  }
}

.doc-title-block {
  text-align: center;
  margin-bottom: 36px;
  padding-bottom: 24px;
  border-bottom: 2px dashed var(--secondary);
}

.doc-label {
  font-size: 0.8rem;
  color: var(--text-sub);
  font-weight: 700;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 6px;
}

.doc-main-title {
  font-size: 1.8rem;
  font-weight: 900;
  color: var(--primary);
  text-shadow: 2px 2px 0 rgba(0, 245, 255, 0.2);
  margin-bottom: 10px;
}

.doc-sub {
  font-size: 0.9rem;
  color: var(--text-sub);
}

.doc-section {
  margin-bottom: 32px;
}

.doc-section-title {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 1.5px dashed var(--secondary);
}

.section-marker {
  color: var(--secondary);
  font-size: 1.1rem;
  animation: pulse-glow 1.5s ease-in-out infinite;
}

@keyframes pulse-glow {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}

.doc-section-title span:nth-child(2) {
  font-size: 1rem;
  font-weight: 800;
  color: var(--text-main);
  flex: 1;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.regen-btn {
  background: rgba(0, 245, 255, 0.1);
  border: 1px solid var(--secondary);
  border-radius: 6px;
  padding: 5px 9px;
  transition: all 0.2s;
}

.regen-btn:hover:not(:disabled) {
  background: rgba(0, 245, 255, 0.2);
  box-shadow: 0 0 10px var(--secondary);
}

.regen-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.spin-inline {
  display: inline-block;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.doc-section-body {
  color: var(--text-main);
  font-size: 0.9rem;
}

.doc-section-body p {
  margin-bottom: 12px;
  text-align: justify;
}

.doc-section-body p:last-child {
  margin-bottom: 0;
}

.doc-section-body-edit {
  width: 100%;
  min-height: 180px;
  padding: 14px;
  border-radius: 8px;
  border: 2px solid var(--border);
  background: rgba(10, 14, 39, 0.8);
  color: var(--text-main);
  font-family: 'Nunito', sans-serif;
  font-size: 0.85rem;
  line-height: 1.5;
  resize: vertical;
  margin-bottom: 12px;
  transition: all 0.3s;
}

.doc-section-body-edit:focus {
  outline: none;
  border-color: var(--secondary);
  background: rgba(10, 14, 39, 0.95);
  box-shadow: 0 0 12px rgba(0, 245, 255, 0.3);
}

.section-regen-loading {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 16px;
  background: rgba(0, 245, 255, 0.08);
  border: 1.5px solid var(--secondary);
  border-radius: 8px;
  color: var(--secondary);
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

/* ===== LOADING OVERLAY ===== */
.loading-overlay {
  position: fixed;
  inset: 0;
  background: linear-gradient(135deg, rgba(5, 8, 16, 0.95), rgba(26, 31, 58, 0.95));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 150;
  gap: 20px;
  backdrop-filter: blur(8px);
}

.loading-anime {
  position: relative;
  width: 110px;
  height: 110px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-ring {
  position: absolute;
  border-radius: 50%;
  border: 2.5px solid transparent;
  animation: spin-ring 2s linear infinite;
}

.loading-ring:nth-child(1) {
  width: 90px;
  height: 90px;
  border-top-color: var(--secondary);
  animation-delay: 0s;
}

.loading-ring:nth-child(2) {
  width: 60px;
  height: 60px;
  border-right-color: var(--primary);
  animation-delay: -0.66s;
}

.loading-ring:nth-child(3) {
  width: 30px;
  height: 30px;
  border-bottom-color: var(--accent);
  animation-delay: -1.32s;
}

@keyframes spin-ring {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-emoji {
  font-size: 2.2rem;
  animation: bounce-loader 1s ease-in-out infinite;
  z-index: 1;
}

@keyframes bounce-loader {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-10px) scale(1.1); }
}

.loading-title {
  font-size: 1.15rem;
  font-weight: 800;
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.loading-status {
  font-size: 0.9rem;
  color: var(--text-sub);
  text-align: center;
}

.progress-bar-wrap {
  width: 220px;
  height: 3px;
  border-radius: 2px;
  background: rgba(0, 245, 255, 0.15);
  overflow: hidden;
  border: 1px solid var(--secondary);
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--secondary));
  border-radius: 2px;
  transition: width 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 0 12px var(--secondary);
}

.anime-fact {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8rem;
  color: var(--text-sub);
  text-align: center;
  max-width: 380px;
  line-height: 1.4;
  animation: fade-in 0.4s ease;
}

.fact-icon {
  font-size: 1.1rem;
  animation: sparkle-loader 1.5s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes sparkle-loader {
  0%, 100% { opacity: 0.5; transform: scale(0.8) rotate(0deg); }
  50% { opacity: 1; transform: scale(1.2) rotate(180deg); }
}

/* ===== TOAST ===== */
.toast-container {
  position: fixed;
  bottom: 20px;
  right: 20px;
  z-index: 300;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.toast {
  padding: 12px 16px;
  border-radius: 8px;
  font-size: 0.85rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 8px;
  animation: slide-in-right 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  border: 2px solid;
  text-transform: uppercase;
  letter-spacing: 0.3px;
}

@keyframes slide-in-right {
  from {
    opacity: 0;
    transform: translateX(120px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.toast.success {
  background: linear-gradient(135deg, rgba(58, 134, 255, 0.15), rgba(0, 245, 255, 0.1));
  border-color: var(--success);
  color: #5aa3ff;
}

.toast.error {
  background: linear-gradient(135deg, rgba(255, 0, 110, 0.15), rgba(255, 0, 110, 0.1));
  border-color: var(--primary);
  color: #ff6b8a;
}

.toast.info {
  background: linear-gradient(135deg, rgba(0, 245, 255, 0.15), rgba(58, 134, 255, 0.1));
  border-color: var(--secondary);
  color: #64e7ff;
}

.toast-close {
  background: none;
  border: none;
  color: inherit;
  cursor: pointer;
  padding: 0;
  font-size: 1.1rem;
  transition: all 0.2s;
  margin-left: auto;
}

.toast-close:hover {
  transform: scale(1.2) rotate(90deg);
}

/* ===== ERROR BOUNDARY ===== */
.error-boundary-screen {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--darker), var(--dark));
  color: var(--text-main);
  padding: 20px;
  text-align: center;
  gap: 20px;
}

.error-emoji {
  font-size: 4rem;
  animation: shake 0.5s ease-in-out infinite;
}

@keyframes shake {
  0%, 100% { transform: translateX(0) rotate(0deg); }
  25% { transform: translateX(-5px) rotate(-2deg); }
  75% { transform: translateX(5px) rotate(2deg); }
}
